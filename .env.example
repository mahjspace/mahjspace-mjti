# Firebase web SDK config — same project as the main app (mahjspace-5e540)
# Copy these from the main mahjspace-app Vercel project's environment variables,
# or from src/firebase.js in the main repo. Same values, just renamed with VITE_ prefix.
#
# IMPORTANT: VITE_FIREBASE_AUTH_DOMAIN must stay as mahjspace-5e540.firebaseapp.com.
# Never change it to mahjspace.com — it breaks the Google auth redirect.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=mahjspace-5e540.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=mahjspace-5e540
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
